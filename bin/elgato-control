def plain_text(value, fallback=""):
    """Keep device- and network-controlled labels out of QML AutoText."""
    return str(value or fallback).replace("<", "‹").replace(">", "›")

def deck_capabilities(deck):
    """Describe a deck from its driver instead of a hand-maintained PID table."""
    visual = bool(deck.is_visual())
    rows, columns = deck.key_layout()
    capabilities = ["keys", "brightness"] if visual else ["pedals"]
    if deck.dial_count() > 0: capabilities += ["dials", "dialPress"]
    if deck.is_touch(): capabilities += ["lcd", "touch"]
    return {"product": plain_text(deck.deck_type(), "Elgato"), "path": deck.id(), "serial": "",
            "kind": "streamdeck" if visual else "pedal", "capabilities": capabilities,
            "keyCount": deck.key_count(), "keyRows": rows, "keyColumns": columns,
            "dialCount": deck.dial_count(), "visual": visual}

def fit_profile(profile, key_count):
    """Grow or trim the key list so every physical key on the deck is addressable."""
    keys = list(profile.get("keys", []))
    if key_count and len(keys) != key_count:
        keys = (keys + [{"label": "", "action": "", "color": [24, 28, 36]}
                        for _ in range(max(0, key_count - len(keys)))])[:key_count]
        profile = dict(profile, keys=keys)
    return profile

def light_request(light, payload=None):
    host = validate_light_host(light.get("host", ""))
    port = int(light.get("port", 9123))
    if port < 1 or port > 65535: raise ValueError("Invalid Key Light port")
    validate_light_resolution(host, port)
    url_host = "[" + host + "]" if ":" in host else host
    url = "http://%s:%d/elgato/lights" % (url_host, port)
    body = None if payload is None else json.dumps({"numberOfLights": 1, "lights": [payload]}).encode()
    req = urllib.request.Request(url, data=body, method="GET" if body is None else "PUT",
                                 headers={"Content-Type": "application/json", "Accept": "application/json"})
    opener = urllib.request.build_opener(NoRedirectHandler())
    with opener.open(req, timeout=1.2) as response:
        data = response.read(65537)
        if len(data) > 65536: raise ValueError("Key Light response is too large")
        return json.loads(data.decode())["lights"][0]

class NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code, "Key Light redirects are not allowed", headers, fp)

def validate_light_host(host):
    value = str(host).strip().rstrip(".")
    try:
        address = ipaddress.ip_address(value)
        if address.is_private or address.is_link_local: return value
        raise ValueError("Key Light address must be private or link-local")
    except ValueError as error:
        if "must be private" in str(error): raise
    if re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,62}\.)*local", value, re.IGNORECASE): return value
    raise ValueError("Key Light host must be a private address or .local hostname")

def validate_light_resolution(host, port):
    try:
        addresses = {item[4][0].split("%", 1)[0] for item in socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)}
    except socket.gaierror as error:
        raise ValueError("Could not resolve Key Light host") from error
    if not addresses: raise ValueError("Could not resolve Key Light host")
    for value in addresses:
        address = ipaddress.ip_address(value)
        if not (address.is_private or address.is_link_local) or address.is_loopback or address.is_unspecified or address.is_multicast:
            raise ValueError("Key Light host resolved outside the local network")
    return addresses

def parse_avahi_lights(text):
    """Parse resolved IPv4 _elg._tcp records emitted by avahi-browse."""
    found = {}
    for line in text.splitlines():
        if not line.startswith("="): continue
        parts = line.split(";")
        if len(parts) < 9 or parts[2] != "IPv4": continue
        host = parts[7].strip()
        if not host: continue
        name = re.sub(r"\\(\d{3})", lambda match: chr(int(match.group(1))), parts[3]).strip()
        try: port = int(parts[8])
        except ValueError: port = 9123
        found[host] = {"name": plain_text(name, "Key Light"), "host": host, "port": port}
    return sorted(found.values(), key=lambda item: item["host"])

def discover_lights(timeout=3):
    executable = shutil.which("avahi-browse")
    if not executable: return []
    try:
        result = subprocess.run([executable, "-tpr", "_elg._tcp"], capture_output=True, text=True, timeout=timeout)
        output = result.stdout or ""
    except subprocess.TimeoutExpired as error:
        output = error.stdout or ""
        if isinstance(output, bytes): output = output.decode("utf-8", "replace")
    except OSError:
        return []
    return parse_avahi_lights(output)

def available_lights():
    configured = load_profile().get("lights", [])
    return configured or discover_lights()

def light_states(lights):
    states = []
    for light in lights:
        entry = dict(light)
        advertised = light.get("name")
        try: entry.update(light_request(light)); entry["reachable"] = True
        except Exception as error: entry["reachable"] = False; entry["error"] = str(error)
        entry["name"] = plain_text(advertised or entry.get("name"), "Key Light")
        states.append(entry)
    return states

def control_lights(target, action, value=None):
    if action in ("brightness", "temperature") and value is None: raise ValueError("Key Light value is required")
    lights = available_lights()
    states = light_states(lights)
    if target == "all": indexes = list(range(len(lights)))
    else:
        index = int(target)
        if index < 0 or index >= len(lights): raise ValueError("Key Light target is out of range")
        indexes = [index]
    changed = 0
    for index in indexes:
        if not states[index].get("reachable"): continue
        current = states[index]
        if action == "on": payload = {"on": 1}
        elif action == "off": payload = {"on": 0}
        elif action == "toggle": payload = {"on": 0 if current.get("on") else 1}
        elif action == "brightness": payload = {"brightness": max(1, min(100, int(value))), "on": 1}
        elif action == "temperature":
            kelvin = max(2900, min(7000, int(value)))
            payload = {"temperature": max(143, min(344, round(1000000 / kelvin))), "on": 1}
        else: raise ValueError("Unsupported Key Light action")
        light_request(lights[index], payload); changed += 1
    if changed == 0: raise RuntimeError("No selected Key Lights are reachable")
    return light_states(lights)

def ensure_profile():
    CONFIG.mkdir(parents=True, exist_ok=True); STATE.mkdir(parents=True, exist_ok=True)
    if not PROFILE.exists():
        legacy_profile = LEGACY_CONFIG / "profile.json"
        shutil.copyfile(legacy_profile if legacy_profile.is_file() else ROOT / "defaults/profile.json", PROFILE)

def load_profile():
    ensure_profile()
    with PROFILE.open() as f: return json.load(f)

def save_profile(profile):
    CONFIG.mkdir(parents=True, exist_ok=True)
    tmp = PROFILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(profile, indent=2) + "\n")
    os.replace(tmp, PROFILE)

def desktop_applications():
    applications = {}
    roots = [pathlib.Path("/usr/share/applications"), pathlib.Path.home() / ".local/share/applications"]
    for directory in roots:
        if not directory.is_dir(): continue
        for path in directory.glob("*.desktop"):
            try:
                values = {}
                for line in path.read_text(errors="replace").splitlines():
                    if "=" in line and not line.startswith((" ", "#")):
                        key, value = line.split("=", 1)
                        if key in ("Name", "Type", "NoDisplay", "Hidden") and key not in values: values[key] = value.strip()
                if values.get("Type", "Application") != "Application": continue
                if values.get("NoDisplay", "false").lower() == "true" or values.get("Hidden", "false").lower() == "true": continue
                desktop_id = path.stem
                if re.fullmatch(r"[A-Za-z0-9_.+-]+", desktop_id) and values.get("Name"):
                    applications[desktop_id] = values["Name"]
            except OSError: continue
    return sorted(applications.items(), key=lambda item: item[1].lower())

def desktop_entry(desktop_id):
    if not re.fullmatch(r"[A-Za-z0-9_.+-]+", desktop_id): return {}
    for directory in (pathlib.Path.home() / ".local/share/applications", pathlib.Path("/usr/share/applications")):
        path = directory / (desktop_id + ".desktop")
        if not path.is_file(): continue
        values = {}
        try:
            for line in path.read_text(errors="replace").splitlines():
                if "=" in line and not line.startswith((" ", "#")):
                    key, value = line.split("=", 1)
                    if key in ("Name", "Icon") and key not in values: values[key] = value.strip()
        except OSError: return {}
        values["desktopId"] = desktop_id; values["path"] = str(path)
        return values
    return {}

def resolve_icon(icon):
    if not icon: return ""
    direct = pathlib.Path(icon)
    if direct.is_file(): return str(direct)
    names = [icon] if pathlib.Path(icon).suffix.lower() in (".svg", ".png", ".xpm", ".jpg", ".jpeg") else [icon + extension for extension in (".svg", ".png", ".xpm")]
    roots = [pathlib.Path.home() / ".local/share/icons", pathlib.Path("/usr/share/icons/hicolor"), pathlib.Path("/usr/share/pixmaps")]
    candidates = []
    for root in roots:
        if not root.is_dir(): continue
        for name in names:
            candidates.extend(root.glob("**/" + name))
    if not candidates: return ""
    def score(path):
        text = str(path)
        for rank, token in enumerate(("256x256", "128x128", "scalable", "512x512", "64x64", "48x48")):
            if token in text: return rank
        return 20
    return str(sorted(candidates, key=score)[0])

def action_icon(action):
    override = USER_ICONS / (action.replace("app:", "app-") + ".png")
    if override.is_file(): return str(override)
    built_in = ICONS / (action + ".jpg")
    if built_in.is_file(): return str(built_in)
    if action.startswith("app:"):
        return resolve_icon(desktop_entry(action[4:]).get("Icon", ""))
    return ""

def action_catalog():
    options = [{"value": action, "label": "Function · " + label, "icon": action_icon(action)} for action, label in BUILTIN_ACTIONS]
    options.extend({"value": action, "label": "Key · " + action_label(action), "icon": action_icon(action)} for action in KEY_ACTIONS)
    options.extend({"value": "app:" + desktop_id, "label": "Application · " + plain_text(name),
                    "icon": action_icon("app:" + desktop_id)}
                   for desktop_id, name in desktop_applications())
    return options

def wrapped_caption(text):
    """Break a label onto its own lines, one word each, at most three.

    ImageMagick's caption: picks the largest pointsize that fits the box
    *width* and only wraps when forced, so "TEAMS MUTE" renders as one small
    line rather than two large ones. Choosing the breaks here instead means the
    pointsize is driven by the longest word, which is what a key needs.
    """
    words = text.split()
    if len(words) == 0: return text
    if len(words) > 3: words = words[:2] + [" ".join(words[2:])]
    return "\n".join(words)

def caption_layer(lines, box_width, box_height):
    """Build the caption as one auto-fitted label: per line, stacked.

    A single caption: block sizes the whole paragraph at once and carries its
    own leading, which leaves two-line captions noticeably smaller than they
    need to be. Fitting each line to its own box and appending them uses the
    space properly.
    """
    line_height = max(6, box_height // len(lines))
    layer = ["("]
    for line in lines:
        layer += ["(", "-background", "none", "-fill", "white", "-font", CAPTION_FONT,
                  "-size", "%dx%d" % (box_width, line_height), "-gravity", "center",
                  "label:" + line, ")"]
    if len(lines) > 1: layer += ["-append"]
    layer += [")"]
    return layer

def rendered_key_image(action, label, color, size=(120, 120)):
    """Render key art at the size the connected deck actually wants.

    The caption is auto-fitted to its box instead of drawn at a fixed
    pointsize, so a short label fills the key and a long one wraps rather than
    shrinking into nothing. A key is read at arm's length, so legibility wins
    over fitting the whole label on one line.
    """
    width, height = int(size[0]), int(size[1])
    converter = shutil.which("magick") or shutil.which("convert")
    if not converter: return None
    source = action_icon(action)
    # Only the bundled pictograms carry a baked-in caption that needs cropping;
    # an override or a desktop icon is already clean art.
    bundled = source == str(ICONS / (action + ".jpg"))
    source_stamp = str(pathlib.Path(source).stat().st_mtime_ns) if source and pathlib.Path(source).is_file() else "none"
    digest = hashlib.sha256(json.dumps(["renderer-v8-iconcaption", action, label, source, source_stamp,
                                        width, height]).encode()).hexdigest()[:20]
    KEY_CACHE.mkdir(parents=True, exist_ok=True)
    output = KEY_CACHE / (digest + ".jpg")
    if output.is_file(): return output
    caption = wrapped_caption(str(label or action_label(action))[:28].upper())
    lines = caption.split("\n")
    pad = max(2, round(height * 0.042))
    command = [converter, "-size", "%dx%d" % (width, height), "xc:#000000"]
    if source:
        # A wrapped caption needs the height more than the icon does, so the
        # icon gives some back rather than the caption being squeezed.
        wraps = len(lines) > 1
        art = max(8, round(height * (0.44 if wraps else 0.54)))
        icon = ["(", source]
        # The bundled tiles bake their own caption into the bottom of the art,
        # so crop that band off rather than shrinking two captions onto one key.
        if bundled: icon += ["-gravity", "North", "-crop", BUILT_IN_ICON_CROP, "+repage"]
        icon += ["-fuzz", "8%", "-trim", "+repage", "-resize", "%dx%d" % (art, art), ")"]
        command += icon + ["-gravity", "north", "-geometry", "+0+%d" % pad, "-composite"]
        caption_height = max(10, round(height * (0.50 if wraps else 0.42)))
    else:
        caption_height = max(10, height - 2 * pad)
    command += caption_layer(lines, max(10, width - 2 * pad), caption_height)
    command += ["-gravity", "south", "-geometry", "+0+%d" % pad, "-composite",
                "-quality", "92", str(output)]
    try: subprocess.run(command, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8)
    except (OSError, subprocess.SubprocessError): return None
    return output

def desktop_file_exists(desktop_id):
    if not re.fullmatch(r"[A-Za-z0-9_.+-]+", desktop_id): return False
    return any((directory / (desktop_id + ".desktop")).is_file() for directory in
               (pathlib.Path("/usr/share/applications"), pathlib.Path.home() / ".local/share/applications"))

def valid_action(action):
    if action in KEY_ACTIONS or any(action == item[0] for item in BUILTIN_ACTIONS): return True
    return action.startswith("app:") and desktop_file_exists(action[4:])

def set_control_action(kind, index, slot, action):
    if not valid_action(action): raise ValueError("Unsupported action: " + action)
    profile = load_profile()
    controls = profile.get(kind, [])
    if index < 0 or index >= len(controls): raise ValueError("Control index is out of range")
    allowed = {"keys": ("action",), "pedals": ("action",), "dials": ("left", "press", "right")}
    if kind not in allowed or slot not in allowed[kind]: raise ValueError("Invalid control slot")
    controls[index][slot] = action
    if slot == "action": controls[index]["label"] = action_label(action)
    save_profile(profile)

def set_pedal_action(index, action):
    set_control_action("pedals", index, "action", action)

def action_label(action):
    if action == "voxtype_push_to_talk": return "VOXtype push-to-talk"
    if action in KEY_ACTIONS: return KEY_ACTIONS[action].replace("_", " ")
    if action.startswith("app:"):
        return dict(desktop_applications()).get(action[4:], action[4:])
    for value, label in BUILTIN_ACTIONS:
        if value == action: return label
    return action.replace("_", " ").title()

def write_status(data):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATUS.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    os.replace(tmp, STATUS)

def command_for(action, wave=None):
    home = str(pathlib.Path.home())
    mic_target = str((wave or {}).get("sourceId", "@DEFAULT_AUDIO_SOURCE@"))
    if action in KEY_ACTIONS: return ["wtype", "-k", KEY_ACTIONS[action]]
    if action.startswith("app:") and desktop_file_exists(action[4:]):
        return ["uwsm-app", "--", "gtk-launch", action[4:]]
    return {
      "terminal": ["omarchy", "launch", "terminal"], "browser": ["omarchy", "launch", "browser"],
      "files": ["uwsm-app", "--", "xdg-open", home], "mic_mute": ["wpctl", "set-mute", mic_target, "toggle"],
      "mic_up": ["wpctl", "set-volume", mic_target, "5%+"], "mic_down": ["wpctl", "set-volume", mic_target, "5%-"],
      "volume_mute": ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"], "volume_up": ["wpctl", "set-volume", "-l", "1.5", "@DEFAULT_AUDIO_SINK@", "5%+"],
      "volume_down": ["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "5%-"], "media_play_pause": ["omarchy-shell", "media", "playPause"],
      "screenshot": ["omarchy", "capture", "screenshot"], "lock": ["omarchy", "system", "lock"],
      "voxtype_push_to_talk": ["voxtype", "record", "start"],
      "omameet": ["omarchy-shell", "shell", "toggle", "acp.omameet"], "workspace_next": ["hyprctl", "dispatch", "workspace", "+1"],
      "workspace_prev": ["hyprctl", "dispatch", "workspace", "-1"], "overview": ["hyprctl", "dispatch", "hyprexpo:expo", "toggle"]
    }.get(action)

def release_command_for(action):
    if action == "voxtype_push_to_talk": return ["voxtype", "record", "stop"]
    return None

def detect_wave():
    """Return a lightweight Wave device record when PipeWire exposes one."""
    try:
        result = subprocess.run(["wpctl", "status"], check=False, capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        return None
    names, source_id, sink_id, section = [], None, None, ""
    for line in result.stdout.splitlines():
        stripped = line.strip()
        if stripped.startswith("├─ Sinks:") or stripped.startswith("├─ Sources:"):
            section = "sinks" if "Sinks" in stripped else "sources"
        if "Elgato Wave" in line:
            name = line.split(". ", 1)[-1].split(" [", 1)[0].strip()
            if name and name not in names: names.append(name)
            try: node_id = int(line.split(".", 1)[0].split()[-1])
            except (ValueError, IndexError): node_id = None
            if section == "sources" and node_id is not None: source_id = node_id
            if section == "sinks" and node_id is not None: sink_id = node_id
    if not names: return None
    card = None
    if source_id is not None:
        try:
            inspect = subprocess.run(["wpctl", "inspect", str(source_id)], capture_output=True, text=True, timeout=2).stdout
            match = re.search(r'alsa\.card\s*=\s*"?(\d+)', inspect)
            if match: card = int(match.group(1))
        except (OSError, subprocess.TimeoutExpired): pass
    wave = {"product": names[0], "kind": "microphone", "capabilities": ["microphone", "mute", "gain", "headphones", "presets"],
            "connected": True, "sourceId": source_id, "sinkId": sink_id, "card": card}
    wave.update(read_wave_controls(card))
    return wave

def read_alsa_control(card, name):
    if card is None: return None
    try:
        output = subprocess.run(["amixer", "-c", str(card), "cget", "name=" + name], capture_output=True,
                                text=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired): return None
    value = re.search(r": values=([^\n]+)", output)
    limits = re.search(r"min=(-?\d+),max=(-?\d+)", output)
    if not value: return None
    raw = value.group(1).strip()
    if raw in ("on", "off"): return {"on": raw == "on"}
    try: number = int(raw.split(",", 1)[0])
    except ValueError: return None
    low, high = (int(limits.group(1)), int(limits.group(2))) if limits else (0, 100)
    return {"value": number, "min": low, "max": high, "percent": round((number - low) * 100 / max(1, high - low))}

def read_wave_controls(card):
    gain = read_alsa_control(card, "Mic Capture Volume") or {}
    mic_switch = read_alsa_control(card, "Mic Capture Switch") or {}
    headphones = read_alsa_control(card, "PCM Playback Volume") or {}
    headphone_switch = read_alsa_control(card, "PCM Playback Switch") or {}
    return {"gainRaw": gain.get("value"), "gainDb": round(gain.get("value", 0) / 2, 1) if gain else None,
            "gainPercent": gain.get("percent"), "muted": not mic_switch.get("on", True),
            "headphonePercent": headphones.get("percent"), "headphoneMuted": not headphone_switch.get("on", True)}

def set_alsa_control(card, name, value):
    if card is None: raise RuntimeError("Wave:3 ALSA card is unavailable")
    result = subprocess.run(["amixer", "-q", "-c", str(card), "cset", "name=" + name, str(value)],
                            capture_output=True, text=True, timeout=3)
    if result.returncode != 0: raise RuntimeError(result.stderr.strip() or "Could not update Wave:3")

def set_default_wave_source(source_id):
    if source_id is None: raise RuntimeError("Wave:3 input is unavailable")
    result = subprocess.run(["wpctl", "set-default", str(source_id)], capture_output=True, text=True, timeout=3)
    if result.returncode != 0: raise RuntimeError(result.stderr.strip() or "Could not set default microphone")

def perform_wave_action(wave, action):
    if not wave: raise RuntimeError("Wave:3 is not connected")
    card = wave.get("card")
    if action == "wave_gain_up": set_alsa_control(card, "Mic Capture Volume", min(80, int(wave.get("gainRaw") or 0) + 2))
    elif action == "wave_gain_down": set_alsa_control(card, "Mic Capture Volume", max(0, int(wave.get("gainRaw") or 0) - 2))
    elif action == "wave_mute": set_alsa_control(card, "Mic Capture Switch", "toggle")
    elif action == "wave_headphone_up": set_alsa_control(card, "PCM Playback Volume", "5%+")
    elif action == "wave_headphone_down": set_alsa_control(card, "PCM Playback Volume", "5%-")
    elif action == "wave_headphone_mute": set_alsa_control(card, "PCM Playback Switch", "toggle")
    elif action == "wave_preset_quiet": set_alsa_control(card, "Mic Capture Volume", 60)  # 30 dB
    elif action == "wave_preset_normal": set_alsa_control(card, "Mic Capture Volume", 40)  # 20 dB
    elif action == "wave_preset_loud": set_alsa_control(card, "Mic Capture Volume", 20)  # 10 dB
    elif action == "wave_default": set_default_wave_source(wave.get("sourceId"))
    else: raise RuntimeError("Unknown Wave action: " + action)

def lcd_svg(profile, brightness, light_states):
    """Build a dependency-light dial strip; ImageMagick converts it to JPEG."""
    dials = list(profile.get("dials", []))[:4]
    lights = [x for x in light_states if x.get("reachable")]
    light = lights[0] if lights else {}
    values = ["System", "Input", "%s%%" % light.get("brightness", "--"),
              "%sK" % round(1000000 / light["temperature"]) if light.get("temperature") else "--"]
    colors = ["#38bdf8", "#f87171", "#fbbf24", "#fb923c"]
    cells = []
    for i in range(4):
        label = dials[i].get("label", "Dial %d" % (i + 1)) if i < len(dials) else "Dial %d" % (i + 1)
        label = (label[:22].replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))
        x = i * 200
        cells.append('<rect x="%d" y="0" width="198" height="100" rx="10" fill="#141820" stroke="#303846"/>' % x)
        cells.append('<circle cx="%d" cy="50" r="27" fill="none" stroke="%s" stroke-width="6" stroke-dasharray="125 45"/>' % (x + 44, colors[i]))
        cells.append('<text x="%d" y="47" fill="#f8fafc" font-size="18" font-family="sans-serif" font-weight="bold">%s</text>' % (x + 82, label))
        cells.append('<text x="%d" y="72" fill="#94a3b8" font-size="16" font-family="sans-serif">%s</text>' % (x + 82, values[i]))
    return '<svg xmlns="http://www.w3.org/2000/svg" width="800" height="100"><rect width="800" height="100" fill="#090b10"/>%s</svg>' % "".join(cells)

class Daemon:
    def __init__(self):
        self.decks, self.events, self.manager = {}, queue.Queue(), None
        self.profile, self.mtime = load_profile(), PROFILE.stat().st_mtime
        self.brightness = int(self.profile.get("brightness", 55))
        self.light_states = []
        self.discovered_lights = []
        self.last_light_discovery = 0
        self.lcd_signature = None
        self.running = True
        self.status = {"running": True, "profile": self.profile.get("name", "Default"), "plus": None, "pedal": None,
                       "wave": None, "lights": [], "devices": [], "recentReports": {},
                       "lastAction": "", "lastEvent": "", "error": BACKEND_ERROR, "updatedAt": int(time.time())}

    def key_image(self, deck, index, key):
        action = key.get("action", "")
        if not action: return
        fmt = deck.key_image_format()
        path = rendered_key_image(action, key.get("label", action_label(action)),
                                  key.get("color", [42, 54, 72]), fmt["size"])
        if not path or not path.exists(): return
        with Image.open(path) as art:
            deck.set_key_image(index, PILHelper.to_native_key_format(deck, art.convert("RGB")))

    def decorate(self, deck):
        entry = self.decks.get(deck.id())
        count = entry["info"]["keyCount"] if entry else deck.key_count()
        profile = fit_profile(self.profile, count)
        try:
            deck.set_brightness(max(0, min(100, self.brightness)))
            for i, key in enumerate(profile.get("keys", [])[:count]):
                self.key_image(deck, i, key)
        except (OSError, RuntimeError, ValueError) as error:
            self.status["error"] = "Deck: " + str(error)
        self.update_lcd(deck, force=True)

    def update_lcd(self, deck, force=False):
        if not deck.is_touch(): return
        signature = json.dumps({"dials": self.profile.get("dials", []), "lights": self.light_states,
                                "brightness": self.brightness}, sort_keys=True, default=str)
        if not force and signature == self.lcd_signature: return
        converter = shutil.which("magick") or shutil.which("convert")
        if not converter:
            self.status["error"] = "LCD rendering requires ImageMagick"
            return
        fmt = deck.touchscreen_image_format()
        try:
            with tempfile.TemporaryDirectory(prefix="elgato-control-lcd-") as directory:
                svg = pathlib.Path(directory) / "lcd.svg"
                png = pathlib.Path(directory) / "lcd.png"
                svg.write_text(lcd_svg(self.profile, self.brightness, self.light_states))
                subprocess.run([converter, str(svg), "-resize", "%dx%d!" % fmt["size"], str(png)], check=True,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
                with Image.open(png) as strip:
                    deck.set_touchscreen_image(PILHelper.to_native_touchscreen_format(deck, strip.convert("RGB")),
                                               0, 0, fmt["size"][0], fmt["size"][1])
            self.lcd_signature = signature
        except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as e:
            self.status["error"] = "LCD: " + str(e)

    def connect(self):
        if DeviceManager is None:
            self.status["error"] = BACKEND_ERROR
            return
        try:
            if self.manager is None: self.manager = DeviceManager()
            found = self.manager.enumerate()
        except Exception as error:
            self.status["error"] = "Enumerate: " + str(error)
            found = []
        live = set()
        for deck in found:
            identifier = deck.id()
            live.add(identifier)
            if identifier in self.decks: continue
            try:
                deck.open()
                deck.reset()
                info = deck_capabilities(deck)
                try: info["serial"] = plain_text(deck.get_serial_number(), "")
                except Exception: pass
                deck.set_key_callback(self._on_key)
                if deck.dial_count() > 0: deck.set_dial_callback(self._on_dial)
                self.decks[identifier] = {"deck": deck, "info": info}
                if info["visual"]:
                    self.sync_profile_size(info["keyCount"])
                    self.decorate(deck)
            except Exception as error:
                self.status["error"] = "Open: " + str(error)
                try: deck.close()
                except Exception: pass
        for identifier in list(self.decks):
            if identifier not in live:
                entry = self.decks.pop(identifier)
                try: entry["deck"].close()
                except Exception: pass
        # Panel.qml keys off status.plus / status.pedal, so keep both slots filled.
        visual = next((e["info"] for e in self.decks.values() if e["info"]["visual"]), None)
        pedal = next((e["info"] for e in self.decks.values() if not e["info"]["visual"]), None)
        self.status["plus"], self.status["pedal"] = visual, pedal
        self.status["wave"] = detect_wave()
        devices = [x for x in (visual, pedal, self.status.get("wave")) if x]
        if self.status.get("lights"):
            devices.append({"product": "Elgato Key Lights", "kind": "lights", "connected": True,
                            "capabilities": ["lights", "power", "brightness", "temperature"],
                            "count": len([x for x in self.status["lights"] if x.get("reachable")])})
        self.status["devices"] = devices

    def sync_profile_size(self, count):
        """Persist a key list matching the deck so every key is addressable."""
        if not count or len(self.profile.get("keys", [])) == count: return
        self.profile = fit_profile(self.profile, count)
        try:
            save_profile(self.profile)
            self.mtime = PROFILE.stat().st_mtime
        except OSError as error:
            self.status["error"] = "Profile: " + str(error)

    def _on_key(self, deck, index, pressed):
        """Runs on the driver read thread: queue only, never dispatch here."""
        self.events.put(("key", deck.id(), index, bool(pressed)))

    def _on_dial(self, deck, index, event, value):
        self.events.put(("dial", deck.id(), index, (event, value)))

    def drain_events(self):
        while True:
            try: kind, identifier, index, payload = self.events.get_nowait()
            except queue.Empty: return
            entry = self.decks.get(identifier)
            if not entry: continue
            info = entry["info"]
            self.status["recentReports"][info["kind"]] = {"control": kind, "index": index,
                                                          "value": str(payload), "at": int(time.time())}
            if kind == "key":
                slot = "keys" if info["visual"] else "pedals"
                controls = self.profile.get(slot, [])
                if index >= len(controls): continue
                action = controls[index].get("action")
                # Press fires the action. Release only does anything for an
                # action that defines one, so a push-to-talk key stops cleanly
                # on a deck key and not just on a pedal.
                if payload: self.act(action)
                else: self.release(action)
            elif kind == "dial":
                dials = self.profile.get("dials", [])
                if index >= len(dials): continue
                event, value = payload
                if event == DialEventType.PUSH:
                    if value: self.act(dials[index].get("press"))
                elif event == DialEventType.TURN and value:
                    action = dials[index].get("right" if value > 0 else "left")
                    for _ in range(min(abs(int(value)), 5)): self.act(action)

    def act(self, action):
        if not action: return
        if action.startswith("wave_"):
            try:
                perform_wave_action(self.status.get("wave"), action)
                self.status["wave"] = detect_wave()
                self.status["error"] = ""
            except (OSError, RuntimeError, subprocess.SubprocessError) as e: self.status["error"] = "Wave: " + str(e)
        elif action.startswith("lights_"):
            self.act_lights(action)
        elif action.startswith("brightness_"):
            self.brightness = 55 if action == "brightness_reset" else max(0, min(100, self.brightness + (5 if action == "brightness_up" else -5)))
            for entry in self.decks.values():
                if not entry["info"]["visual"]: continue
                try: entry["deck"].set_brightness(self.brightness)
                except (OSError, RuntimeError, ValueError) as e: self.status["error"] = "Deck: " + str(e)
                self.update_lcd(entry["deck"])
        else:
            cmd = command_for(action, self.status.get("wave"))
            if cmd:
                try: subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except OSError as e: self.status["error"] = str(e)
            else: self.status["error"] = "Unknown action: " + action
        self.status["lastAction"] = action; self.status["lastEvent"] = time.strftime("%H:%M:%S")

    def release(self, action):
        cmd = release_command_for(action)
        if not cmd: return
        try: subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e: self.status["error"] = str(e)
        self.status["lastAction"] = action + " release"; self.status["lastEvent"] = time.strftime("%H:%M:%S")

    def refresh_lights(self):
        configured = self.profile.get("lights", [])
        if not configured and (not self.discovered_lights or time.monotonic() - self.last_light_discovery > 300):
            self.discovered_lights = discover_lights()
            self.last_light_discovery = time.monotonic()
        states = []
        for light in configured or self.discovered_lights:
            entry = dict(light)
            try: entry.update(light_request(light)); entry["reachable"] = True
            except Exception as e: entry["reachable"] = False; entry["error"] = str(e)
            states.append(entry)
        self.light_states = states; self.status["lights"] = states
        for deck_entry in self.decks.values():
            self.update_lcd(deck_entry["deck"])

    def act_lights(self, action):
        if not self.light_states: self.refresh_lights()
        reachable = [x for x in self.light_states if x.get("reachable")]
        if not reachable: self.status["error"] = "No Elgato lights reachable"; return
        current = reachable[0]
        if action == "lights_toggle": payload = {"on": 0 if any(x.get("on") for x in reachable) else 1}
        elif action == "lights_brightness_up": payload = {"brightness": min(100, int(current.get("brightness", 40)) + 5), "on": 1}
        elif action == "lights_brightness_down": payload = {"brightness": max(1, int(current.get("brightness", 40)) - 5), "on": 1}
        elif action == "lights_warmer": payload = {"temperature": min(344, int(current.get("temperature", 200)) + 10), "on": 1}
        elif action == "lights_cooler": payload = {"temperature": max(143, int(current.get("temperature", 200)) - 10), "on": 1}
        else: return
        for light in self.profile.get("lights", []) or self.discovered_lights:
            try: light_request(light, payload)
            except Exception as e: self.status["error"] = "Light: " + str(e)
        self.refresh_lights()

    def loop(self):
        last_connect = last_status = last_lights = 0
        while self.running:
            now = time.monotonic()
            if now - last_connect > 2: self.connect(); last_connect = now
            if now - last_lights > 5: self.refresh_lights(); last_lights = now
            try:
                mtime = PROFILE.stat().st_mtime
                if mtime != self.mtime:
                    self.profile, self.mtime = load_profile(), mtime
                    self.lcd_signature = None
                    for entry in self.decks.values():
                        if entry["info"]["visual"]: self.decorate(entry["deck"])
            except (OSError, ValueError, json.JSONDecodeError) as e: self.status["error"] = "Profile: " + str(e)
            self.drain_events()
            if now - last_status > .5:
                self.status.update(running=True, brightness=self.brightness,
                                   profile=self.profile.get("name", "Default"), updatedAt=int(time.time()))
                write_status(self.status); last_status = now
            time.sleep(.025)
        for entry in self.decks.values():
            try:
                entry["deck"].reset()
                entry["deck"].close()
            except Exception: pass
        self.status["running"] = False; write_status(self.status)

def main():
    p = argparse.ArgumentParser(); sub = p.add_subparsers(dest="command", required=True)
    sub.add_parser("daemon"); sub.add_parser("init"); sub.add_parser("profile"); sub.add_parser("catalog")
    pedal = sub.add_parser("set-pedal"); pedal.add_argument("index", type=int, choices=(1, 2, 3)); pedal.add_argument("action")
    key = sub.add_parser("set-key"); key.add_argument("index", type=int, choices=range(1, 33)); key.add_argument("action")
    dial = sub.add_parser("set-dial"); dial.add_argument("index", type=int, choices=range(1, 5)); dial.add_argument("slot", choices=("left", "press", "right")); dial.add_argument("action")
    wave = sub.add_parser("wave"); wave.add_argument("action", choices=("gain-up", "gain-down", "mute", "headphone-up", "headphone-down", "headphone-mute", "preset-quiet", "preset-normal", "preset-loud", "default"))
    lights = sub.add_parser("lights"); lights.add_argument("action", choices=("on", "off", "toggle", "brightness", "temperature", "refresh")); lights.add_argument("--target", default="all"); lights.add_argument("--value", type=int)
    status = sub.add_parser("status"); status.add_argument("--json", action="store_true")
    args = p.parse_args(); ensure_profile()
    if args.command == "init": print(PROFILE); return
    if args.command == "profile": print(json.dumps(load_profile(), indent=2)); return
    if args.command == "catalog": print(json.dumps(action_catalog())); return
    if args.command == "set-pedal":
        try: set_pedal_action(args.index - 1, args.action)
        except ValueError as error: p.error(str(error))
        print(PROFILE); return
    if args.command == "set-key":
        try: set_control_action("keys", args.index - 1, "action", args.action)
        except ValueError as error: p.error(str(error))
        print(PROFILE); return
    if args.command == "set-dial":
        try: set_control_action("dials", args.index - 1, args.slot, args.action)
        except ValueError as error: p.error(str(error))
        print(PROFILE); return
    if args.command == "wave":
        mapping = {"gain-up": "wave_gain_up", "gain-down": "wave_gain_down", "mute": "wave_mute",
                   "headphone-up": "wave_headphone_up", "headphone-down": "wave_headphone_down",
                   "headphone-mute": "wave_headphone_mute", "preset-quiet": "wave_preset_quiet",
                   "preset-normal": "wave_preset_normal", "preset-loud": "wave_preset_loud", "default": "wave_default"}
        current = detect_wave()
        try: perform_wave_action(current, mapping[args.action])
        except (OSError, RuntimeError, subprocess.SubprocessError) as error: p.error(str(error))
        print(json.dumps(detect_wave())); return
    if args.command == "lights":
        try:
            result = light_states(available_lights()) if args.action == "refresh" else control_lights(args.target, args.action, args.value)
        except (OSError, RuntimeError, ValueError, urllib.error.URLError) as error: p.error(str(error))
        print(json.dumps(result)); return
    if args.command == "status":
        data = json.loads(STATUS.read_text()) if STATUS.exists() else {"running": False, "plus": None, "pedal": None, "profile": load_profile().get("name", "Default")}
        print(json.dumps(data) if args.json else json.dumps(data, indent=2)); return
    daemon = Daemon()
    signal.signal(signal.SIGTERM, lambda *_: setattr(daemon, "running", False)); signal.signal(signal.SIGINT, lambda *_: setattr(daemon, "running", False))
    daemon.loop()

if __name__ == "__main__": main()
