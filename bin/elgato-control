#!/usr/bin/env python3
"""Small hidapi-based Stream Deck daemon for Omarchy."""
import argparse, hashlib, ipaddress, json, os, pathlib, queue, re, shutil, signal, socket, subprocess, sys, tempfile, time, urllib.error, urllib.request

try:
    from PIL import Image
    from StreamDeck.DeviceManager import DeviceManager
    from StreamDeck.Devices.StreamDeck import DialEventType
    from StreamDeck.ImageHelpers import PILHelper
    BACKEND_ERROR = ""
except ImportError as error:  # keep the daemon alive so the panel can say why
    DeviceManager = DialEventType = Image = PILHelper = None
    BACKEND_ERROR = "python-elgato-streamdeck is not installed: %s" % error

ROOT = pathlib.Path(__file__).resolve().parent.parent
CONFIG = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")) / "elgato-control"
STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")) / "elgato-control"
LEGACY_CONFIG = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")) / "omarchy-streamdeck"
PROFILE = CONFIG / "profile.json"
STATUS = STATE / "status.json"
ICONS = ROOT / "assets" / "keys"
KEY_CACHE = pathlib.Path(os.environ.get("XDG_CACHE_HOME", pathlib.Path.home() / ".cache")) / "elgato-control" / "keys"
# Condensed bold fits noticeably more legible text on a 96px key than the
# regular face, and the bundled tiles hide their own caption in this band.
CAPTION_FONT = "/usr/share/fonts/noto/NotoSans-CondensedBold.ttf"
BUILT_IN_ICON_CROP = "100%x68%+0+0"
# Drop a PNG named after an action here to give it your own key art. Built-in
# actions ship only eight pictograms, and nothing else has a way to get one.
USER_ICONS = pathlib.Path(os.environ.get("XDG_DATA_HOME", pathlib.Path.home() / ".local/share")) / "elgato-control" / "icons"
KEY_ACTIONS = {
    "key_home": "Home", "key_end": "End", "key_page_up": "Page_Up", "key_page_down": "Page_Down",
    "key_left": "Left", "key_right": "Right", "key_up": "Up", "key_down": "Down",
    "key_enter": "Return", "key_escape": "Escape", "key_space": "space", "key_tab": "Tab",
}
